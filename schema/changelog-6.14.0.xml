<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd"
  logicalFilePath="changelog-6.14.0">

  <changeSet author="author" id="changelog-6.14.0-mobile-messages">

    <createTable tableName="tc_mobile_messages">
      <column name="id" type="INT" autoIncrement="true">
        <constraints primaryKey="true" />
      </column>
      <column name="deviceid" type="INT">
        <constraints nullable="false" />
      </column>
      <column name="messageid" type="VARCHAR(64)">
        <constraints nullable="false" />
      </column>
      <column name="sequence" type="BIGINT">
        <constraints nullable="false" />
      </column>
      <column name="status" type="VARCHAR(16)">
        <constraints nullable="false" />
      </column>
      <column name="positionid" type="INT" />
      <column name="payloadhash" type="VARCHAR(128)" />
      <column name="created" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false" />
      </column>
      <column name="updated" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false" />
      </column>
    </createTable>

    <addForeignKeyConstraint baseTableName="tc_mobile_messages"
      baseColumnNames="deviceid" constraintName="fk_mobile_messages_deviceid"
      referencedTableName="tc_devices" referencedColumnNames="id" onDelete="CASCADE" />
    <addUniqueConstraint tableName="tc_mobile_messages"
      columnNames="deviceid, sequence" constraintName="uk_mobile_messages_device_sequence" />
    <addUniqueConstraint tableName="tc_mobile_messages"
      columnNames="messageid" constraintName="uk_mobile_messages_messageid" />

    <createIndex tableName="tc_mobile_messages" indexName="mobile_messages_device_sequence">
      <column name="deviceid" />
      <column name="sequence" />
    </createIndex>
    <createIndex tableName="tc_mobile_messages" indexName="mobile_messages_status">
      <column name="status" />
    </createIndex>

  </changeSet>

</databaseChangeLog>
