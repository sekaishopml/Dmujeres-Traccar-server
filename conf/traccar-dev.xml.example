<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE properties SYSTEM "http://java.sun.com/dtd/properties.dtd">
<!--
  TEMPLATE de config de DESARROLLO — versionado (sin secretos).
  Copiar a server/conf/traccar-dev.xml (gitignored) y completar secretos,
  o generar automáticamente con: infrastructure/scripts/run-server-dev.sh (make-config)
  Los secretos se inyectan por variables de entorno (config.useEnvironmentVariables=true):
  DATABASE_PASSWORD, WEB_SECRET_TOKEN, ...
-->
<properties>

  <entry key="config.useEnvironmentVariables">true</entry>

  <!-- Web / API / Dashboard (dev: bind localhost; en VPS abrir por firewall si hace falta) -->
  <entry key="web.address">127.0.0.1</entry>
  <entry key="web.port">8082</entry>
  <entry key="web.path">../dashboard/build</entry>
  <entry key="web.sessionTimeout">604800</entry>
  <entry key="web.console">true</entry>

  <!-- Base de datos: PostgreSQL / TimescaleDB (host port 5433) -->
  <entry key="database.driver">org.postgresql.Driver</entry>
  <entry key="database.url">jdbc:postgresql://localhost:5433/traccar</entry>
  <entry key="database.user">traccar</entry>
  <entry key="database.maxPoolSize">20</entry>
  <entry key="database.checkConnection">SELECT 1</entry>

  <!-- Realtime: eventos de estado de conexión de dispositivos -->
  <entry key="event.status.enable">true</entry>

  <!-- Logging -->
  <entry key="logger.level">info</entry>

</properties>
